# Copy this file to ".env" and fill in your real values.
# .env is git-ignored so your subscription key is never committed.

# --- LLM API (Qwen-32B via Azure API Management) ---
LLM_API_URL=https://ltceip4prod.azure-api.net/qwen32b/chat/completions
LLM_API_KEY=your-ocp-apim-subscription-key-here
LLM_SYSTEM_PROMPT=You are a helpful assistant.
LLM_MAX_TOKENS=5000
# LLM_TEMPERATURE=0.7        # optional; omit to use the server default
LLM_TIMEOUT=120

# --- STT (faster-whisper) ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto          # auto | cuda | cpu  (auto -> cuda on the H200)
WHISPER_COMPUTE_TYPE=auto    # auto | float16 | int8_float16 | int8
# WHISPER_LANGUAGE=en        # leave unset to auto-detect
WHISPER_BEAM_SIZE=5
